RTC_DATA_ATTR float lastPoids  = -1.0f;
RTC_DATA_ATTR float lastTemp   = -99.0f;
RTC_DATA_ATTR float lastBat    = -1.0f;
RTC_DATA_ATTR uint32_t skipCount = 0;
RTC_DATA_ATTR uint32_t heartbeat = 0;
// ROM DS18B20 mis en cache pour éviter une énumération à chaque réveil
RTC_DATA_ATTR uint8_t ds1ROM[8] = {0};
RTC_DATA_ATTR uint8_t ds2ROM[8] = {0};
RTC_DATA_ATTR bool romsScanned = false;

